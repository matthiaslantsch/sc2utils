{
	"name": "holonet/sc2utils",
	"description": "Replay parser for Starcraft 2",
	"require": {
		"php": ">=8.4",
		"ext-bz2": "*",
		"ext-zlib": "*",
		"holonet/bitstream": "^1.0.0",
		"holonet/common": "dev-develop"
	},
	"require-dev": {
		"ext-gd": "*",
		"ergebnis/composer-normalize": "^2.5",
		"friendsofphp/php-cs-fixer": "^3.13",
		"phpunit/phpunit": "*",
		"vimeo/psalm": "^6.0"
	},
	"repositories": [
		{
			"type": "git",
			"url": "https://github.com/matthiaslantsch/holonet-common.git"
		},
		{
			"type": "git",
			"url": "https://github.com/matthiaslantsch/holonet-bitstream.git"
		}
	],
	"autoload": {
		"psr-4": {
			"holonet\\sc2utils\\": "src/",
			"holonet\\sc2utils\\scripts\\": "scripts/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"holonet\\sc2utils\\tests\\": "tests/"
		}
	},
	"bin": [
		"scripts/replay-dump.php",
		"scripts/replay-organiser.php"
	],
	"config": {
		"allow-plugins": {
			"ergebnis/composer-normalize": true
		}
	},
	"scripts": {
		"fix": [
			"@composer normalize --diff --ansi",
			"@php -d memory_limit=-1 vendor/friendsofphp/php-cs-fixer/php-cs-fixer fix --verbose --ansi --diff"
		],
		"test": [
			"@composer validate --ansi",
			"@composer normalize --dry-run --diff --ansi",
			"Composer\\Config::disableProcessTimeout",
			"@php -d xdebug.mode=coverage -d memory_limit=-1 vendor/phpunit/phpunit/phpunit -c phpunit.xml --colors=always",
			"Composer\\Config::enableProcessTimeout",
			"@php -d memory_limit=-1 vendor/friendsofphp/php-cs-fixer/php-cs-fixer fix --verbose --dry-run --ansi --diff",
			"@php -d memory_limit=-1 vendor/vimeo/psalm/psalm"
		]
	}
}
